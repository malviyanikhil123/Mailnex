# PostgreSQL connection (individual values — no DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=email_automation

# Auth + encryption secrets
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# ENCRYPTION_KEY must be exactly 32 characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Gmail (optional bootstrap — also editable from the Settings page)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Server
PORT=4000
UPLOAD_DIR=./uploads
NODE_ENV=development
TEST_EMAIL=

# Reverse proxy. Off by default: req.ip (used by the rate limits) is the socket address.
# Behind nginx or another proxy, set the number of proxies in front of the API (usually
# 1). "true" is refused: it would trust a client-written X-Forwarded-For. Never enable
# it when the API is reachable directly.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API with credentials, e.g.
# CORS_ORIGINS=https://mailnex.example.com,http://localhost:5173
# Leave empty to allow any origin (the previous behaviour).
CORS_ORIGINS=
