# PostgreSQL connection (individual values — no DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=email_automation

# Auth + encryption secrets
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# ENCRYPTION_KEY must be exactly 32 characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Gmail (optional bootstrap — also editable from the Settings page)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Gemini (optional bootstrap — also editable from the Settings page)
GEMINI_API_KEY=

# Server
PORT=4000
UPLOAD_DIR=./uploads
NODE_ENV=development
TEST_EMAIL=

# Job Autopilot
DATABASE_URL=postgres://user:password@host:5432/database
WEB_PORT=5055
FRONT_PORT=5056
JOB_ROLES="business analyst"
JOB_COUNTRIES=in,remote
JOB_MAX_AGE_DAYS=45
ASK_THRESHOLD=60
AUTO_APPLY_THRESHOLD=80
OPENROUTER_API_KEY=

