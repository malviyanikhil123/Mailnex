# Root environment for docker-compose (compose substitutes these).
# Copy to .env and edit. Do NOT commit the filled-in .env.

# PostgreSQL (used by the postgres service AND passed to the backend as DB_*)
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=email_automation

# Backend secrets
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Exactly 32 characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Optional bootstrap (also editable from the Settings page)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GEMINI_API_KEY=

# Frontend → backend URL (baked into the frontend image at build time)
VITE_API_URL=http://localhost:4000
